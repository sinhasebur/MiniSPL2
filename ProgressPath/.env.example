# Copy this file to .env and replace the placeholder with your Gemini API key.
GEMINI_API_KEY=replace_with_your_key
# GOOGLE_API_KEY=replace_with_your_key

# If both keys are supplied, GOOGLE_API_KEY takes precedence.

# Optional: change the model or request timeout without editing Java code.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
